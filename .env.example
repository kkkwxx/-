# 复制为 .env 后使用。.env 不进仓库（技术栈 §8）
APP_ENV=dev
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# 主库：同步驱动 psycopg3（技术栈 §6）
DATABASE_URL=postgresql+psycopg://mystery:change-me@localhost:5433/mystery_news
TEST_DATABASE_URL=postgresql+psycopg://mystery:change-me@localhost:5433/mystery_news_test

# 单管理员认证（技术栈 §5.2）。密码只存 bcrypt 哈希
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173

# 采集（技术栈 §5.5 / 04-采集 §15）
CRAWL_USER_AGENT=MysteryNewsDemo/1.0 (+mailto:contact@example.com)
CRAWL_MAX_ATTEMPTS=5
CRAWL_TIMEOUT_SECONDS=25
CRAWL_SOURCE_CONCURRENCY=4
MAX_AGE_DAYS=3
MAX_RESPONSE_BYTES=5242880
HOST_MIN_INTERVAL_SEC=1
GOOGLE_NEWS_MIN_INTERVAL_SEC=2
FULL_TEXT_BATCH_SIZE=20
# 探活参数必须独立于采集（03 §8.4 V1）：超时 8s、重试 1 次
VALIDATE_TIMEOUT_SECONDS=8
VALIDATE_MAX_ATTEMPTS=1

# 可选代理：本机可直连，只有换机不通时才配（04 §7.6）
HTTP_PROXY=
HTTPS_PROXY=

# AI（本期未接入，先占位）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_CLASSIFY=qwen3.8-flash
LLM_MODEL_GENERATE=qwen-plus
LLM_MODEL_HARD=qwen3.8-max
LLM_RESPONSE_FORMAT=json_object
LLM_DAILY_TOKEN_BUDGET=200000

# 预处理与事件判定（05-预处理与事件判定 §11）
PREPROCESS_BATCH_SIZE=50
PREPROCESS_CONCURRENCY=4
EVENT_CONFIDENCE_MIN=0.7
NOT_EVENT_CONFIDENCE_MIN=0.8
PROMPT_VERSION=v1

# 演示回放：只能替换外部 IO，不能绕过闸门（04 §15）
REPLAY_MODE=false
RAW_HTML_MAX_DB_BYTES=1048576
